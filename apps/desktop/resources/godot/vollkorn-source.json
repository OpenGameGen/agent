  "changes": [
    "Extract selected editing functions into a RefCounted module; exclude the MCP/CLI dispatcher, editor bridge, filesystem tools, tests, screenshots and input.",
    "Replace one-shot prints/quit with operation-local messages/errors and early returns; propagate missing scene/node failures.",
    "Use CACHE_MODE_IGNORE_DEEP for all native resource/dependency loads.",
    "Track and free allocated scene nodes after each operation; free removed nodes immediately.",
    "Do not assign the root node as its own owner.",
    "Persist signal connections with CONNECT_PERSIST.",
    "Allow add_animation to bind a separately edited Animation resource; check library existence before lookup.",
    "The Host adapter validates path, class, property and operation arguments before invoking source functions.",
    "Verify node property readback before saving; refuse rejected or adjusted values instead of reporting a successful edit.",
    "Validate and convert node values once in the product dispatcher; set_node_properties no longer reinterprets already validated Dictionary values."
  ],
  "productExtensions": [
    "resource inspection, single-property type validation and subresource editing",
    "Curve/Gradient points and Theme items",
    "manual TileSet atlas and single tile editing",
    "small-step tool schemas, native resource references, lifetime and transport",
    "short-lived native edit groups with rollback, one committed-group undo, size limits and external-change/symlink conflict checks"
  ]
}
